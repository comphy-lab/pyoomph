+// x^n for one factor of a binomial expansion, with the 0^0 == 1 convention that such an expansion
+// requires. GiNaC's pow() throws "power::eval(): pow(0,0) is undefined" instead, which makes
+// real_part()/imag_part() of an integer power abort whenever the basis has a zero real OR a zero
+// imaginary part - e.g. (I*x)^2, whose expansion contains a term with the factor a^0 = 0^0.
+static ex binomial_expansion_pow(const ex & x, long n)
+{
+	if (n == 0)
+		return _ex1;
+	return pow(x, n);
+}
